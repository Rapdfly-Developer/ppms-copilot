# ── Server-only variables ──────────────────────────────────────────────────────
# These must NEVER be prefixed with NEXT_PUBLIC_ — they would become
# client-accessible and expose credentials to the browser.

# Anthropic API key — this project's own key, not PPMS Core's.
# Required. Obtain from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Base URL of PPMS Core (no trailing slash).
# The Copilot calls /api/v1/* on this host to fetch clinical data.
# The browser never sees this value.
PPMS_CORE_URL=https://ppmsai.com

# AI model to use. Defaults to claude-opus-5 if not set.
# Change to a different model without redeploying code.
AI_MODEL=claude-opus-5

# Per-request timeout in milliseconds. Default: 60000 (1 minute).
# Increase to 120000 for patients with large visit histories (Clinical Timeline).
AI_REQUEST_TIMEOUT_MS=120000

# ── Public variables ───────────────────────────────────────────────────────────
# These are safe for the browser. NEXT_PUBLIC_ prefix makes them available
# in client components. Never put secrets here.

# Exact origin of PPMS Core — used to validate postMessage event.origin.
# Must match the exact URL doctors use to access PPMS (no trailing slash).
NEXT_PUBLIC_PPMS_ORIGIN=https://ppmsai.com

# Displayed in the Copilot UI footer.
NEXT_PUBLIC_COPILOT_VERSION=1.0.0

# ── Local development overrides ────────────────────────────────────────────────
# For local dev, override these in .env.local (git-ignored):
#
# PPMS_CORE_URL=http://localhost:3000
# NEXT_PUBLIC_PPMS_ORIGIN=http://localhost:3000
#
# Then either use ngrok to expose this project to PPMS Core, or use
# DEV_STUB_MODE=true to bypass postMessage and use fixture data.
#
# DEV_STUB_MODE=true     # activates the postMessage stub (dev only)
